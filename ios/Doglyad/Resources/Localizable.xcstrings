    "onBoardingDescriptionFifth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next, scan the patient: take a photo of the examination, fill in the patient data, describe the examination, and submit it to generate medical protocol."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Далее, сканируйте пациента: делайте фото исследования, заполняйте данные пациента, описывайте проведенное исследование и отправляйте, чтобы сгенерировать протокол УЗИ."
          }
        }
      }
    },
    "onBoardingDescriptionFirst": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doglyad is an AI assistant that generates ultrasound reports based on patient data.\nThe reports are generated by a specialized neural network model trained on large-scale medical research data."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Догляд — ИИ-ассистент, который генерирует протоколы УЗИ на основе данных пациента.\nПротоколы генерируются специальной нейронной моделью, обученной на большом объёме данных медицинских исследований."
          }
        }
      }
    },
    "onBoardingDescriptionFourth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To get started, first select the ultrasound type."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для того, чтобы начать работу, сначала выберите тип ультразвукового исследования."
          }
        }
      }
    },
    "onBoardingDescriptionSecond": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doglyad is capable of screening for undetected pathologies and is intended for use by medical professionals.\nIt is not recommended for use by patients or individuals without appropriate medical training."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Догляд способен выявлять скрытые патологии и предназначен для использования медицинскими специалистами.\nНе рекомендуется для использования пациентами или лицами без соответствующего медицинского образования."
          }
        }
      }
    },
    "onBoardingDescriptionThird": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app uses artificial intelligence models to generate medical reports.\nThe generated results are for informational and advisory purposes only.\nPlease read and accept the app's terms of use."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение использует модели искусственного интеллекта для генерации протоколов УЗИ.\nРезультаты генерации носят исключительно рекомендательный и вспомогательный характер.\nПожалуйста, ознакомьтесь и примите условия использования приложения."
          }
        }
      }
    },
    "onBoardingLegalAcceptAndDescription": {
      "extractionState": "manual",
