    "neuralModelTemperatureDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperature shapes how boldly the neural model samples the wording when it composes text, steering between safe, likely choices and broader exploration.\nLower values tighten answers toward steadier wording, and higher values increase variety—useful interfaces often expose a range around 0–2."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Температура задаёт, насколько смело нейромодель сэмплирует фрагменты текста, балансируя между более вероятными и менее типичными формулировками.\nНизкие значения склоняют ответ к устойчивым формулировкам, а высокие усиливают разнообразие — в интерфейсах часто используют диапазон порядка 0–2."
          }
        }
      }
    },
    "neuralModelTemperatureLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperature"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Температура"
          }
        }
      }
    },
    "neuralModelTemperaturePlaceholder": {
