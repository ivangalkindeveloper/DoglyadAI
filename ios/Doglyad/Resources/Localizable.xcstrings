    "neuralModelMarkdownDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown is a markup for highlighting text with headings, bold, underlining, etc.\nWhen model mode is disabled, the response is given only in solid text."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown - разметка выделенения текста заголовками, жирным, подчеркивание и т.д.\nПри выключенном режиме модели задаётся ответ только сплошным текстом."
          }
        }
      }
    },
    "neuralModelMarkdownLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown markup"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разметка Markdown"
          }
        }
      }
    },
    "neuralModelMaxTokensDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum tokens caps how much text the neural model may emit in one answer, counted in tokenizer units rather than plain characters or whole words.\nRaising the ceiling allows longer explanations."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимум токенов ограничивает объём текста, который нейромодель может сгенерировать за один ответ, в единицах токенизатора, а не в символах или целых словах.\nБольший верхний предел допускает более развёрнутые протоколы."
          }
        }
      }
    },
    "neuralModelMaxTokensLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Max tokens length"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Макс. количество токенов"
