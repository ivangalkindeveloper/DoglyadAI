    "neuralModelMaxTokensDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum tokens caps how much text the neural model may emit in one answer, counted in tokenizer units rather than plain characters or whole words.\nRaising the ceiling allows longer explanations."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимум токенов ограничивает объём текста, который нейромодель может сгенерировать за один ответ, в единицах токенизатора, а не в символах или целых словах.\nБольший верхний предел допускает более развернутые заключения."
          }
        }
      }
    },
    "neuralModelMaxTokensLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Max tokens length"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Макс. количество токенов"
          }
        }
      }
    },
    "neuralModelMaxTokensPlaceholder": {
      "extractionState": "manual",
