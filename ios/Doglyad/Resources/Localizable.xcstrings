    "neuralModelMarkdownDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown is a markup for highlighting text with headings, bold, underlining, etc.\nWhen model mode is disabled, the response is given only in solid text."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown - разметка выделенения текста заголовками, жирным, подчеркивание и т.д.\nПри выключенном режиме модели задаётся ответ только сплошным текстом."
          }
        }
      }
