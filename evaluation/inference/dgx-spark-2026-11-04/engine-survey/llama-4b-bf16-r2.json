{
  "name": "llama-4b-bf16-r2",
  "engine": "llama.cpp",
  "entrypoint": "/survey/llama.cpp/build/bin/llama-server",
  "args": [
    "--model",
    "/survey/medgemma-4b-bf16.gguf",
    "--mmproj",
    "/survey/medgemma-4b-mmproj-bf16.gguf",
    "--n-gpu-layers",
    "999",
    "--ctx-size",
    "16384",
    "--parallel",
    "4",
    "--flash-attn",
    "on",
    "--host",
    "127.0.0.1",
    "--port",
    "8000",
    "--alias",
    "google/medgemma-4b-it",
    "--jinja",
    "--cache-type-k",
    "bf16",
    "--cache-type-v",
    "bf16"
  ],
  "env": [
    "LD_LIBRARY_PATH=/survey/llama.cpp/build/bin:/usr/local/cuda/lib64:/usr/local/nvidia/lib64"
  ]
}
