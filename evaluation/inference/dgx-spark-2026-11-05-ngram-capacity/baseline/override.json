{
  "services": {
    "vllm_medgemma_27b": {
      "command": [
        "google/medgemma-27b-it",
        "--served-model-name",
        "google/medgemma-27b-it",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--dtype",
        "bfloat16",
        "--max-model-len",
        "16384",
        "--max-num-seqs",
        "4",
        "--max-num-batched-tokens",
        "2048",
        "--gpu-memory-utilization",
        "0.55",
