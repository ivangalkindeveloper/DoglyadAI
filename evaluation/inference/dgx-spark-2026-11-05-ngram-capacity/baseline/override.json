        "8589934592",
        "--revision",
        "2d3e00ea38b50018bf5dd3aa1009457cd2d5a48f",
        "--limit-mm-per-prompt",
        "{\"image\": 6}",
        "--speculative-config",
        "{\"method\":\"ngram\",\"num_speculative_tokens\":8,\"prompt_lookup_min\":2,\"prompt_lookup_max\":5}",
        "--enable-prefix-caching",
        "--no-enable-log-requests",
        "--no-enable-log-outputs",
        "--structured-outputs-config",
        "{\"backend\":\"xgrammar\",\"disable_any_whitespace\":true}"
