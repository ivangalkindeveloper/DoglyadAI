{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(tree:*)",
      "Bash(pwd)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(which:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git check-ignore:*)",
      "Bash(git mv:*)",
      "Bash(git push:*)",
      "Bash(git restore:*)",
      "Bash(git rm:*)",
      "Bash(gh repo:*)",
      "Bash(make format:*)",
      "Bash(make format-backend:*)",
      "Bash(make lint-backend:*)",
      "Bash(make typecheck-backend:*)",
      "Bash(make test-backend:*)",
      "Bash(make build-ios:*)",
      "Bash(make build-ios-debug-local:*)",
      "Bash(make build-ios-debug-development:*)",
      "Bash(make build-ios-release-development:*)",
      "Bash(make build-ios-release-production:*)",
      "Bash(make upload-ios-release-development:*)",
      "Bash(make upload-ios-release-production:*)",
      "Bash(make start-backend-main-development:*)",
      "Bash(make stop-backend-main:*)",
      "Bash(make test-ios:*)",
      "Bash(make pip-install-dev:*)",
      "Bash(docker build:*)",
      "Bash(docker compose:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(pytest:*)",
      "Bash(swiftformat:*)",
      "Bash(swift --version)",
      "Bash(xcodebuild:*)",
      "Bash(xcrun simctl list:*)",
      "WebSearch",
      "WebFetch(domain:aistudio.yandex.ru)",
      "WebFetch(domain:antongubarenko.substack.com)",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:beget.com)",
      "WebFetch(domain:docs.selectel.ru)",
      "WebFetch(domain:ekacod.ru)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:gonka.ai)",
      "WebFetch(domain:gpuindex.ru)",
      "WebFetch(domain:hostkey.ru)",
      "WebFetch(domain:huggingface.co)",
      "WebFetch(domain:immers.cloud)",
      "WebFetch(domain:intelion.cloud)",
      "WebFetch(domain:machinelearning.apple.com)",
      "WebFetch(domain:medai-t.github.io)",
      "WebFetch(domain:picovoice.ai)",
      "WebFetch(domain:rudrank.com)",
      "WebFetch(domain:selectel.ru)",
      "WebFetch(domain:tproger.ru)",
      "WebFetch(domain:unsloth.ai)",
      "WebFetch(domain:www.cnews.ru)",
      "WebFetch(domain:yandex.cloud)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/security-check.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(python3 -c \"import sys, json; print(json.load(sys.stdin).get('tool_input', {}).get('file_path', ''))\" 2>/dev/null); case \"$file\" in *.swift) make -C \"$CLAUDE_PROJECT_DIR\" format ;; esac"
          }
        ]
      }
    ]
  }
}
