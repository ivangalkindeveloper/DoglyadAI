    "genderLabel": "\\bпол\\s*:?\\s*(?P<gender>{genderWord})\\b",
    "height": "\\bрост\\s*(?:(?:составляет|равен)\\s*)?:?\\s*(?P<value>{numberPhrase}(?:\\s+запятая\\s+{numberPhrase})?)\\s*(?P<unit>\\w*)",
    "kilograms": "^(?:кг|килограмм\\w*)$",
    "measurementUnit": "\\b(?:мм|см|мл|кг|миллимет\\w*|сантимет\\w*|миллилит\\w*|килограм\\w*)\\b",
    "meters": "^(?:м|метр\\w*)$",
    "naturalBirthDate": "(?<!\\w)(?P<day>{numberPhrase})\\s+(?P<month>{monthWord})\\s+(?P<year>{numberPhrase})(?!\\w)",
    "numberJoiner": "",
    "numberJoinerWord": "(?!)",
    "numberLabel": "\\bномер\\s+исследования\\b|\\bисследование\\s+(?:номер\\b|№)|\\bисследование\\s*[#№]",
    "numericBirthDate": "(?<!\\d)(?:(?P<iso>\\d{4}-\\d{2}-\\d{2})|(?P<day>\\d{1,2})\\.(?P<month>\\d{1,2})\\.(?P<year>\\d{4}))(?!\\d)",
    "numericCorrection": "(?<!\\w)(?P<old>{numberPhrase})\\s*,\\s*нет\\s*,\\s*(?P<new>{numberPhrase})(?=\\s*(?:мм\\b|см\\b|мл\\b|миллимет\\w*|сантимет\\w*|миллилит\\w*))",
    "patientIntroduction": "сегодня\\s+обследуем\\s*$",
    "patientLabel": "\\b(?:пациент(?:ка|а)?|фио)\\b\\s*:?\\s*$",
    "selfCorrection": ",\\s*нет\\s*,",
    "uncertainDate": "\\b(?:или|возможно|примерно|кажется)\\b",
    "uncertainNumber": ",\\s*нет\\s*,|\\b(?:или|возможно)\\b",
