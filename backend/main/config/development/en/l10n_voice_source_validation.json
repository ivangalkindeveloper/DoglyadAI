  "patterns": {
    "birthLabel": "\\b(?:date\\s+of\\s+birth|birth\\s*date|dob|born)\\b\\s*:?\\s*",
    "birthTrailingLabel": "(?!)",
    "centimeters": "^(?:cm|centimet(?:er|re)s?)$",
    "clinicalConjunctionSuffix": "\\s+(?:and)$",
    "clinicalNaturalMarker": "\\b(?P<description>on\\s+ultrasound|ultrasound\\s+(?:shows|findings))\\b\\s*[:,]?\\s*|\\b(?P<complaints>(?:they|he|she|the\\s+patient)\\s+(?:reports?|complains?\\s+of))\\b\\s*:?\\s*|\\b(?P<other>(?:height|weight)\\s*(?:is\\s*)?(?=[:\\d]|{numberPhrase})|(?:and\\s+)?weighs?\\s+|this\\s+is\\s+study\\s+|study\\s+(?:number|id|no\\.)\\s*|today['’]s\\s+patient\\s+is\\s+)",
    "decimalSeparator": "\\s+point\\s+",
    "fetalCue": "\\b(?:fetal|fetus|foetus)\\b",
    "genderLabel": "\\b(?:gender|sex)\\s*(?:is\\s*)?:?\\s*(?P<gender>{genderWord})\\b",
    "height": "\\bheight\\s*(?:(?:is|of)\\s*)?:?\\s*(?P<value>{numberPhrase}(?:\\s+point\\s+{numberPhrase})?)\\s*(?P<unit>\\w*)|\\b(?P<tall>{numberPhrase})\\s+(?:centimeters?|centimetres?)\\s+tall\\b",
    "kilograms": "^(?:kg|kilograms?)$",
    "measurementUnit": "\\b(?:mm|cm|ml|kg|millimet\\w*|centimet\\w*|millilit\\w*|kilogram\\w*)\\b",
    "meters": "^(?:m|met(?:er|re)s?)$",
    "naturalBirthDate": "(?<!\\w)(?:the\\s+)?(?P<day>{numberPhrase})(?:\\s+of)?\\s+(?P<month>{monthWord})\\s+(?P<year>{numberPhrase})(?!\\w)|(?<!\\w)(?P<month_first>{monthWord})\\s+(?P<day_after>\\d{1,2})(?:st|nd|rd|th)?\\s*,?\\s+(?P<year_after>\\d{4})(?!\\d)",
    "numberJoiner": "(?:and\\s+)?",
    "numberJoinerWord": "^and$",
    "numberLabel": "\\b(?:examination|exam|study)\\s+(?:number\\b|no\\b\\.?|id\\b|reference\\b)|\\bthis\\s+is\\s+(?:the\\s+)?study\\b|\\b(?:examination|exam|study)\\s*[#№]",
    "numericBirthDate": "(?<!\\d)(?:(?P<iso>\\d{4}-\\d{2}-\\d{2})|(?P<month>\\d{1,2})[./](?P<day>\\d{1,2})[./](?P<year>\\d{4}))(?!\\d)",
    "numericCorrection": "(?<!\\w)(?P<old>{numberPhrase})\\s*,\\s*no\\s*,\\s*(?P<new>{numberPhrase})(?=\\s*(?:mm\\b|cm\\b|ml\\b|millimet\\w*|centimet\\w*|millilit\\w*))",
    "patientIntroduction": "(?:today['’]s)\\s*$",
    "patientLabel": "\\b(?:patient\\s+name|patient)\\b\\s*(?:is\\s*)?:?\\s*$",
    "selfCorrection": ",\\s*no\\s*,",
    "uncertainDate": "\\b(?:or|maybe|perhaps)\\b",
    "uncertainNumber": ",\\s*no\\s*,|\\b(?:or|maybe)\\b",
    "weight": "\\b(?:weight|weighs?)\\s*(?:(?:is|of)\\s*)?:?\\s*(?P<value>{numberPhrase}(?:\\s+point\\s+{numberPhrase})?)\\s*(?P<unit>\\w*)"
  },
