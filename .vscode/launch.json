{
    // Each configuration first runs a tasks.json task that merges secrets/.env
    // with its profile into secrets/.env.running. This matches the variables
    // passed through env_file by `make start-backend-*`.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend: Local Mock",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host", "0.0.0.0",
                "--port", "8000"
            ],
            "cwd": "${workspaceFolder}/backend/main",
            "preLaunchTask": "env: development",
            "envFile": "${workspaceFolder}/backend/main/secrets/.env.running",
            "env": {
                "MODEL_SERVICE_TYPE": "mock"
            }
        },
        {
            "name": "Backend: Development",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host", "0.0.0.0",
                "--port", "8000"
            ],
            "cwd": "${workspaceFolder}/backend/main",
            "preLaunchTask": "env: development",
            "envFile": "${workspaceFolder}/backend/main/secrets/.env.running",
            "env": {
                "MODEL_SERVICE_TYPE": "inference"
            }
        },
        {
            "name": "Backend: Production",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host", "0.0.0.0",
                "--port", "8000"
            ],
            "cwd": "${workspaceFolder}/backend/main",
            "preLaunchTask": "env: production",
            "envFile": "${workspaceFolder}/backend/main/secrets/.env.running",
            "env": {
                "MODEL_SERVICE_TYPE": "inference"
            }
        }
    ]
}
