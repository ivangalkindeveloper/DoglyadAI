{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend: Local Mock (Cold)",
            "type": "debugpy",
            "request": "launch",
            "module": "app.local_main",
            "cwd": "${workspaceFolder}/backend/main",
            "preLaunchTask": "backend: clean local preparation",
            "envFile": "${workspaceFolder}/backend/main/secrets/.env.running",
            "env": {
                "ENVIRONMENT": "development",
                "MODEL_SERVICE_TYPE": "mock",
                "DATABASE_URL": "postgresql+asyncpg://doglyad_local:doglyad_local_only@127.0.0.1:5433/doglyad_database"
            }
        },
        {
            "name": "Backend: Local Inference (Cold)",
            "type": "debugpy",
            "request": "launch",
            "module": "app.local_main",
            "cwd": "${workspaceFolder}/backend/main",
            "preLaunchTask": "backend: clean local preparation",
            "envFile": "${workspaceFolder}/backend/main/secrets/.env.running",
            "env": {
                "ENVIRONMENT": "development",
                "MODEL_SERVICE_TYPE": "inference",
                "DATABASE_URL": "postgresql+asyncpg://doglyad_local:doglyad_local_only@127.0.0.1:5433/doglyad_database"
            }
        },
        {
            "name": "Backend: Local Mock",
            "type": "debugpy",
            "request": "launch",
            "module": "app.local_main",
            "cwd": "${workspaceFolder}/backend/main",
            "preLaunchTask": "backend: local preparation",
            "envFile": "${workspaceFolder}/backend/main/secrets/.env.running",
            "env": {
                "ENVIRONMENT": "development",
                "MODEL_SERVICE_TYPE": "mock",
                "DATABASE_URL": "postgresql+asyncpg://doglyad_local:doglyad_local_only@127.0.0.1:5433/doglyad_database"
            }
        },
        {
            "name": "Backend: Local Inference",
            "type": "debugpy",
            "request": "launch",
            "module": "app.local_main",
            "cwd": "${workspaceFolder}/backend/main",
            "preLaunchTask": "backend: local preparation",
            "envFile": "${workspaceFolder}/backend/main/secrets/.env.running",
            "env": {
                "ENVIRONMENT": "development",
                "MODEL_SERVICE_TYPE": "inference",
                "DATABASE_URL": "postgresql+asyncpg://doglyad_local:doglyad_local_only@127.0.0.1:5433/doglyad_database"
            }
        },
        {
            "name": "Backend: Development Inference",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}/backend/main",
            "preLaunchTask": "env: development",
            "envFile": "${workspaceFolder}/backend/main/secrets/.env.running",
            "env": {
                "MODEL_SERVICE_TYPE": "inference"
            }
        },
        {
            "name": "Backend: Production Inference",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}/backend/main",
            "preLaunchTask": "env: production",
            "envFile": "${workspaceFolder}/backend/main/secrets/.env.running",
            "env": {
                "MODEL_SERVICE_TYPE": "inference"
            }
        }
    ]
}
