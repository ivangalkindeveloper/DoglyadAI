{
    // Build the debug environment exactly like docker-compose: merge the shared
    // secrets/.env with a profile-specific file, with later definitions winning.
    // Use `awk 1` instead of `cat` to insert missing newlines between files.
    // secrets/.env.running is overwritten before every run and is ignored by Git.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "backend: clean local preparation",
            "dependsOn": ["env: development", "billing: clean local"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "billing: clean local",
            "type": "process",
            "command": "make",
            "args": ["reset-local-billing"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "backend: local preparation",
            "dependsOn": ["env: development", "billing: local"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "billing: local",
            "type": "process",
            "command": "make",
            "args": ["start-local-billing"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "env: development",
            "type": "shell",
            "command": "awk 1 secrets/.env secrets/.env.development > secrets/.env.running",
            "options": {
                "cwd": "${workspaceFolder}/backend/main"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "env: production",
            "type": "shell",
            "command": "awk 1 secrets/.env secrets/.env.production > secrets/.env.running",
            "options": {
                "cwd": "${workspaceFolder}/backend/main"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
